# ===================================================================
# MacroGuard — Szablon konfiguracji środowiskowej (.env.example)
# ===================================================================
# Aby uruchomić projekt lokalnie:
# 1. Skopiuj ten plik jako '.env': cp .env.example .env
# 2. Ustaw własne, bezpieczne hasło do bazy danych PostgreSQL.
# ===================================================================

POSTGRES_USER=macroguard
POSTGRES_PASSWORD=twoje_bezpieczne_haslo_deweloperskie
POSTGRES_DB=macroguard_db

